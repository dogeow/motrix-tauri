{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "motrix-tauri",
  "version": "0.0.1",
  "identifier": "com.dogeow.motrix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Motrix",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet", "motrix"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDQjUzRjI2QkU3NTAwMDMKUldRREFIVytKaisxYkVHRFJzRjgwN3BuU09MYno4N1Y2OGxDWGFHYnlmTkZSV25yd0FuUEhlMksK",
      "endpoints": [
        "https://github.com/dogeow/motrix-tauri/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aria2c"],
    "resources": ["resources/aria2.conf"],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent Document",
        "description": "BitTorrent 种子文件",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ]
  }
}
